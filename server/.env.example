# Server Configuration
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/fixnest
JWT_SECRET=your_jwt_secret_key_here
APP_URL=http://localhost:5173

# Gmail API & Email Notifications Setup
# To send real emails via Gmail:
# 1. Turn on 2-Step Verification on your Google Account: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and 16-character App Password below:
GMAIL_USER=your-app-email@gmail.com
GMAIL_PASS=your-16-char-app-password
EMAIL_FROM=FIXNEST Platform <no-reply@fixnest.com>
